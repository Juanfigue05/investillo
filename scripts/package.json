{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "backup": "tsx ./src/backup.ts",
    "backup:ci": "tsx ./src/backup.ts",
    "backup:local": "tsx ./src/backup-local.ts",
    "sync:local": "tsx ./src/sincronizar-local.ts",
    "sync:status": "tsx ./src/estado-sincronizacion.ts",
    "sync:init": "tsx ./src/iniciar-sincronizacion.ts",
    "sync:pull": "tsx ./src/sincronizar-remoto.ts",
    "sync:all": "tsx ./src/sincronizar-todo.ts",
    "test": "tsx --test src/lib/credito-lineas-sync.test.ts src/lib/clasificar-respuesta.test.ts",
    "test:sync-local": "tsx --test src/lib/sincronizar-local.test.ts",
    "test:sync-e2e": "pnpm --filter @workspace/api-server run build && tsx --test src/lib/sincronizacion.e2e.test.ts",
    "setup:local": "tsx ./src/preparar-local.ts",
    "verificar": "tsx ./src/verificar-consistencia.ts",
    "limpiar-operaciones": "tsx ./src/limpiar-operaciones-viejas.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "pg": "^8.13.1"
  }
}
