# SOLO EN EL PORTÁTIL: copia este ejemplo a `.env.local` en la raíz y completa
# allí la conexión local, la URL HTTPS real del API de Render y el mismo token
# configurado en Render. Nunca escribas el token real en este ejemplo ni en Git.
# PostgreSQL local del portátil; debe apuntar a investillo_sync_local en localhost:5433.
DATABASE_URL=postgresql://postgres@localhost:5433/investillo_sync_local
PORT=8080
NODE_ENV=production
SYNC_ENTORNO=portatil
SYNC_FECHA_CORTE=2026-11-01
# Orígenes externos autorizados, separados por comas. En producción use HTTPS.
# El frontend servido por el mismo API no necesita aparecer aquí.
CORS_ORIGINS=http://localhost:5173
# En `.env.local`, pon la URL HTTPS real del API de Render terminada en `/api`.
SYNC_REMOTE_API_URL=
# En `.env.local`, copia el token existente de Render; no lo generes ni lo guardes aquí.
SYNC_TOKEN=
LOCAL_BACKUP_DIR=backups/local
LOCAL_BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe