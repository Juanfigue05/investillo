# PostgreSQL que vive en esta computadora.
DATABASE_URL=postgresql://postgres:CAMBIE_ESTA_CONTRASENA@localhost:5432/investillo_local
PORT=8080
NODE_ENV=production
# Orígenes externos autorizados, separados por comas. En producción use HTTPS.
# El frontend servido por el mismo API no necesita aparecer aquí.
CORS_ORIGINS=http://localhost:5173
# URL HTTP del sistema/API en Render, no una URL de PostgreSQL ni de Supabase.
SYNC_REMOTE_API_URL=https://TU-SERVICIO.onrender.com/api
# Usa el mismo secreto aleatorio de al menos 32 bytes que configuraste en Render.
SYNC_TOKEN=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_BACKUP_DIR=backups/local
LOCAL_BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe